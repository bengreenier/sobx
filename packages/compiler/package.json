{
	"name": "@sobx/compiler",
	"version": "0.0.1-alpha.1",
	"type": "module",
	"author": {
		"name": "Ben Greenier",
		"email": "ben+npm@bengreenier.com"
	},
	"licenses": [
		{
			"type": "MIT"
		},
		{
			"type": "Apache-2.0"
		}
	],
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./vite": {
			"types": "./dist/types/vite.d.ts",
			"import": "./dist/vite.js",
			"require": "./dist/vite.cjs"
		},
		"./rollup": {
			"types": "./dist/types/rollup.d.ts",
			"import": "./dist/rollup.js",
			"require": "./dist/rollup.cjs"
		},
		"./webpack": {
			"types": "./dist/types/webpack.d.ts",
			"import": "./dist/webpack.js",
			"require": "./dist/webpack.cjs"
		},
		"./esbuild": {
			"types": "./dist/types/esbuild.d.ts",
			"import": "./dist/esbuild.js",
			"require": "./dist/esbuild.cjs"
		},
		"./rolldown": {
			"types": "./dist/types/rolldown.d.ts",
			"import": "./dist/rolldown.js",
			"require": "./dist/rolldown.cjs"
		},
		"./rspack": {
			"types": "./dist/types/rspack.d.ts",
			"import": "./dist/rspack.js",
			"require": "./dist/rspack.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "pnpm run build:types && pnpm run build:lib",
		"build:types": "tsc -p tsconfig.lib.json",
		"build:lib": "vite build",
		"lint": "biome check .",
		"test": "vitest --coverage"
	},
	"dependencies": {
		"@babel/generator": "^8.0.0",
		"@babel/parser": "^8.0.4",
		"@babel/traverse": "^8.0.4",
		"@babel/types": "^8.0.4",
		"@sobx/core": "workspace:*",
		"unplugin": "^3.3.0",
		"unplugin-ast": "^0.17.2"
	},
	"peerDependencies": {
		"@rspack/core": "*",
		"esbuild": "*",
		"rolldown": "*",
		"rollup": "*",
		"vite": "*",
		"webpack": "*"
	},
	"peerDependenciesMeta": {
		"esbuild": {
			"optional": true
		},
		"rolldown": {
			"optional": true
		},
		"rollup": {
			"optional": true
		},
		"@rspack/core": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"webpack": {
			"optional": true
		}
	},
	"devDependencies": {
		"@rspack/core": "^2.1.5",
		"esbuild": "^0.28.1",
		"mobx": "^6.16.1",
		"rolldown": "^1.2.0",
		"rollup": "^4.62.2",
		"tsx": "^4.23.1",
		"vite": "^8.1.5",
		"webpack": "^5.109.0"
	}
}
