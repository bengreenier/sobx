{
	"name": "@sobx/compiler",
	"version": "0.0.1-alpha.1",
	"type": "module",
	"author": {
		"name": "Ben Greenier",
		"email": "ben+npm@bengreenier.com"
	},
	"licenses": [
		{
			"type": "MIT"
		},
		{
			"type": "Apache-2.0"
		}
	],
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./vite": {
			"types": "./dist/types/vite.d.ts",
			"import": "./dist/vite.js",
			"require": "./dist/vite.cjs"
		},
		"./rollup": {
			"types": "./dist/types/rollup.d.ts",
			"import": "./dist/rollup.js",
			"require": "./dist/rollup.cjs"
		},
		"./webpack": {
			"types": "./dist/types/webpack.d.ts",
			"import": "./dist/webpack.js",
			"require": "./dist/webpack.cjs"
		},
		"./esbuild": {
			"types": "./dist/types/esbuild.d.ts",
			"import": "./dist/esbuild.js",
			"require": "./dist/esbuild.cjs"
		},
		"./rolldown": {
			"types": "./dist/types/rolldown.d.ts",
			"import": "./dist/rolldown.js",
			"require": "./dist/rolldown.cjs"
		},
		"./rspack": {
			"types": "./dist/types/rspack.d.ts",
			"import": "./dist/rspack.js",
			"require": "./dist/rspack.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "pnpm run build:types && pnpm run build:lib",
		"build:types": "tsc -p tsconfig.lib.json",
		"build:lib": "vite build",
		"lint": "biome check .",
		"test": "vitest --coverage"
	},
	"dependencies": {
		"@sobx/core": "workspace:*",
		"@babel/generator": "^7.29.1",
		"@babel/parser": "^7.29.0",
		"@babel/traverse": "^7.29.0",
		"@babel/types": "^7.29.0",
		"unplugin": "^3.0.0",
		"unplugin-ast": "^0.16.0"
	},
	"peerDependencies": {
		"esbuild": "*",
		"rolldown": "*",
		"rollup": "*",
		"@rspack/core": "*",
		"vite": "*",
		"webpack": "*"
	},
	"peerDependenciesMeta": {
		"esbuild": {
			"optional": true
		},
		"rolldown": {
			"optional": true
		},
		"rollup": {
			"optional": true
		},
		"@rspack/core": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"webpack": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/babel__traverse": "^7.18.0",
		"esbuild": "^0.27.3",
		"mobx": "^6.15.0",
		"sobx": "workspace:*",
		"rolldown": "^0.15.1",
		"rollup": "^4.0.0",
		"tsx": "^4.21.0",
		"webpack": "^5.0.0",
		"@rspack/core": "^1.7.7"
	}
}
